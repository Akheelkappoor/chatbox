        "jsCode": "// Portfolio Data - MINIMAL Version\nconst data = $input.all()[0].json;\n\nreturn [{\n  json: {\n    // Basic info\n    profile: {\n      fullName: `${data.profile.name} ${data.profile.title}`,\n      email: data.profile.email,\n      location: data.profile.location,\n      availability: data.profile.availability\n    },\n    \n    // The MOST IMPORTANT - formatted text for AI Agent\n    formattedContext: data.formattedContext,\n    \n    // Keep original data just in case\n    originalData: data\n  }\n}];"
